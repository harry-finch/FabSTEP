{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FabSTEP",
  "version": "1.0.0-rc.1",
  "identifier": "fr.fabapps.fabstep",
  "build": {
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "beforeDevCommand": "npm --prefix ../../ui run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5181",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Reconstruction de solides STEP \u00e0 partir de maillages STL et 3MF",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-"
    }
  }
}
